{
  "name": "ux-planner",
  "version": "0.2.0",
  "private": true,
  "description": "Local web app for the personas, user journeys, flows and stories that live in your repository as Markdown and JSON.",
  "license": "MIT",
  "author": "Mattia Michini",
  "homepage": "https://github.com/mattiamichini-design/uxplanner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattiamichini-design/uxplanner.git"
  },
  "bugs": {
    "url": "https://github.com/mattiamichini-design/uxplanner/issues"
  },
  "scripts": {
    "dev": "npm run build --workspace ux-planner-core && next dev",
    "build": "npm run build --workspace ux-planner-core && next build && npm run build:mcp && node scripts/package-runtime.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "demo": "npm run build --workspace ux-planner-core && node bin/ux-planner.mjs demo --dev",
    "typecheck": "npm run build --workspace ux-planner-core && tsc --noEmit",
    "site:fonts": "node site/scripts/fetch-fonts.mjs",
    "site:dev": "npm run build --workspace ux-planner-core && npm run site:fonts && next dev site --port 3100",
    "site:build": "npm run build --workspace ux-planner-core && npm run site:fonts && next build site",
    "site:typecheck": "npm run build --workspace ux-planner-core && tsc -p site --noEmit",
    "pack:release": "npm run build && node scripts/pack-release.mjs",
    "test:core": "npm test --workspace ux-planner-core",
    "verify:release": "node scripts/verify-release.mjs",
    "build:mcp": "node scripts/build-mcp.mjs",
    "test:mcp": "node scripts/verify-mcp.mjs",
    "test:routing": "node scripts/verify-workspace-routing.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@lisse/core": "0.7.3",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-compose-refs": "1.1.5",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gray-matter": "4.0.3",
    "lucide-react": "1.59.0",
    "mermaid": "12.2.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "ux-planner-core": "0.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "bin": {
    "ux-planner": "bin/ux-planner.mjs"
  },
  "engines": {
    "node": ">=22.15"
  },
  "workspaces": [
    "packages/*"
  ]
}
